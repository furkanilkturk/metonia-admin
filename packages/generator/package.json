{
	"name": "@metonia-admin/generator",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"assets",
		"dist"
	],
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"check": "tsc --project tsconfig.json",
		"lint": "eslint src --max-warnings=0",
		"format:check": "prettier --check src package.json tsconfig.json tsconfig.build.json",
		"test": "bun test src --pass-with-no-tests",
		"build": "tsc --project tsconfig.build.json"
	},
	"dependencies": {
		"@metonia-admin/registry": "workspace:*",
		"cross-spawn": "7.0.6",
		"sv": "0.17.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6"
	}
}
